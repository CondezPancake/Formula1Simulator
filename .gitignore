target/
*.class
.idea/
*.iml
# Se ignora el CONTENIDO de .vscode, no la carpeta: git no puede volver a
# incluir un fichero si su directorio padre esta excluido, asi que con
# ".vscode/" las excepciones de abajo no harian nada.
.vscode/*
# La configuracion de arranque si se comparte: sin ella el boton Run de VS Code
# no sabe por que clase empezar.
!.vscode/launch.json
!.vscode/settings.json
.DS_Store

# Originales de imagenes (18 MB). La aplicacion consume las copias
# redimensionadas de simulator/src/main/resources/images/, generadas con
# tools/copiar_imagenes.py.
docs/assets/F1_Recursos_Multimedia/img-vehiculos/
docs/assets/F1_Recursos_Multimedia/img-circuitos/

# Metraje original del fondo de vídeo que tuvo el menú (410 MB). Ya no se usa
# -el fondo es un slideshow de fotos, ver docs/features/ui-menu.md- pero se
# deja ignorado por si el fichero sigue en disco.
media-src/
