<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.LiveRaceController" spacing="14">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2" styleClass="section-header">
            <Label fx:id="lblEvento" styleClass="view-title"/>
            <Label fx:id="lblCircuito" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblReloj" styleClass="counter-value"/>
        <Button fx:id="btnFinalizar" text="FINALIZAR SIMULACIÓN" styleClass="primary" onAction="#onFinalizar"/>
    </HBox>

    <ProgressBar fx:id="progresoSesion" progress="0" maxWidth="Infinity"/>

    <!-- Métricas del piloto propio, que es de quien hay telemetría -->
    <HBox spacing="14">
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="PILOTO EN PISTA" styleClass="tile-label"/>
            <Label fx:id="lblPiloto" text="—" styleClass="tile-value"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="VELOCIDAD" styleClass="tile-label"/>
            <Label fx:id="lblVelocidad" text="—" styleClass="tile-value,v-speed"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="TIEMPO DE VUELTA" styleClass="tile-label"/>
            <Label fx:id="lblTiempo" text="—" styleClass="tile-value,v-time"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="DESGASTE" styleClass="tile-label"/>
            <Label fx:id="lblDesgaste" text="—" styleClass="tile-value,v-wear"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="PILOTOS EN META" styleClass="tile-label"/>
            <Label fx:id="lblCompletados" text="0 / 0" styleClass="tile-value,v-grip"/>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="CLASIFICACIÓN EN CURSO" styleClass="detail-kicker"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPosicion" text="Pos" prefWidth="60"/>
                    <TableColumn fx:id="colPiloto" text="Piloto" prefWidth="190"/>
                    <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="190"/>
                    <TableColumn fx:id="colTiempo" text="Tiempo" prefWidth="110"/>
                    <TableColumn fx:id="colGap" text="Dif." prefWidth="95"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="8" prefWidth="330" minWidth="330">
            <Label text="INCIDENCIAS" styleClass="detail-kicker"/>
            <VBox fx:id="avisos" spacing="8" styleClass="live-feed" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
