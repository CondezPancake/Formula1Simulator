<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Gestión de equipos: tabla filtrable a la izquierda y ficha de detalle a la
  derecha, mismo patrón que Pilotos. El alta/edición/baja siguen siendo los
  diálogos de Forms.equipo(...) y TeamService.
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.TeamController"
      styleClass="mgmt-root" spacing="14">
    <padding><Insets top="24" right="26" bottom="20" left="26"/></padding>

    <!-- ============================ CABECERA ============================ -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="EQUIPOS" styleClass="mgmt-title"/>
            <Label text="Gestiona las escuderías de la parrilla" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="0">
            <Label fx:id="lblConteo" text="0 / 0" styleClass="mgmt-count-value"/>
            <Label text="EQUIPOS REGISTRADOS" styleClass="mgmt-count-label"/>
        </VBox>
    </HBox>

    <!-- ============================ TOOLBAR ============================= -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="mgmt-toolbar">
        <TextField fx:id="buscador" promptText="Buscar equipo…" prefWidth="240"/>
        <ComboBox fx:id="filtroPais" promptText="PAÍS" prefWidth="160"/>
        <ComboBox fx:id="ordenarPor" prefWidth="150"/>
        <Button fx:id="btnOrdenDireccion" styleClass="icon-button" text="↑"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="+ NUEVO EQUIPO" styleClass="primary,mgmt-new-button"/>
    </HBox>

    <!-- ============================ CONTENIDO ============================ -->
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.7" styleClass="mgmt-split">

        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" text="Equipo" prefWidth="190"/>
                <TableColumn fx:id="colPais" text="País" prefWidth="120"/>
                <TableColumn fx:id="colMotor" text="Motor" prefWidth="110"/>
                <TableColumn fx:id="colNumPilotos" text="Nº" prefWidth="45"/>
                <TableColumn fx:id="colCampeonatos" text="Camp." prefWidth="60"/>
                <TableColumn fx:id="colVictorias" text="Vict." prefWidth="60"/>
            </columns>
        </TableView>

        <!-- ============================ Ficha lateral ============================ -->
        <StackPane fx:id="panelDetalle" styleClass="mgmt-detail"
                   minWidth="360" prefWidth="360" maxWidth="360">
            <VBox fx:id="detalleVacio" alignment="CENTER" spacing="8">
                <Label text="Selecciona un equipo" styleClass="mgmt-empty-title"/>
                <Label text="Elige una fila de la tabla para ver su ficha." styleClass="mgmt-empty-subtitle" wrapText="true"/>
            </VBox>

            <ScrollPane fx:id="detalleScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="edge-to-edge" visible="false" managed="false">
                <VBox fx:id="detalleContenido" visible="false" managed="false" spacing="0">
                    <StackPane fx:id="detalleFoto" styleClass="mgmt-detail-photo"/>

                    <VBox spacing="2">
                        <padding><Insets top="14" right="18" bottom="6" left="18"/></padding>
                        <Label fx:id="detalleNombre" styleClass="mgmt-detail-last"
                               maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                        <Label fx:id="detalleSubtitulo" styleClass="mgmt-detail-team"
                               maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                    </VBox>

                    <TabPane fx:id="tabsDetalle" tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <Tab text="RESUMEN">
                                <VBox fx:id="tabResumen" spacing="8">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                </VBox>
                            </Tab>
                            <Tab text="ESTADÍSTICAS">
                                <VBox fx:id="tabEstadisticas" spacing="10">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>

                    <VBox spacing="8">
                        <padding><Insets top="12" right="18" bottom="18" left="18"/></padding>
                        <Button fx:id="btnEditar" text="EDITAR EQUIPO" maxWidth="Infinity"
                                styleClass="mgmt-action-button"/>
                        <Button fx:id="btnEliminar" text="ELIMINAR EQUIPO" maxWidth="Infinity"
                                styleClass="mgmt-delete-button"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </SplitPane>
</VBox>
