<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.TeamController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <Label text="Equipos" styleClass="view-title"/>
    <Label text="Escuderías con su motor y sus pilotos." styleClass="view-subtitle"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="buscador" promptText="Buscar por nombre, país o motor…" prefWidth="320"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" styleClass="primary" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" styleClass="danger" onAction="#onEliminar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Equipo" prefWidth="190"/>
            <TableColumn fx:id="colPais" text="País" prefWidth="130"/>
            <TableColumn fx:id="colMotor" text="Motor" prefWidth="120"/>
            <TableColumn fx:id="colNumPilotos" text="Nº" prefWidth="45"/>
            <TableColumn fx:id="colPilotos" text="Pilotos" prefWidth="320"/>
        </columns>
    </TableView>
</VBox>
