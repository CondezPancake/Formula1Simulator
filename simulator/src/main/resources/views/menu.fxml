<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Menú principal al estilo del de F1 23 (docs/assets/f1-23-menu-referencia.jpg).

  Pantalla partida en dos columnas reales, no posicionado a mano: la izquierda
  lleva la lista de opciones, la derecha el escenario con el título de la
  sección. Las filas de la lista las construye MainMenuController, porque el
  texto, la descripción y el destino de cada una viven juntos allí.
-->
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.formula1.controller.MainMenuController"
          fx:id="raiz" styleClass="menu-root"
          prefWidth="1600" prefHeight="940">

    <columnConstraints>
        <!-- 47/53: la proporción de la referencia. -->
        <ColumnConstraints percentWidth="47"/>
        <ColumnConstraints percentWidth="53"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>

    <!-- ==================== columna izquierda ==================== -->
    <VBox fx:id="panelIzquierdo" styleClass="menu-panel"
          GridPane.columnIndex="0" GridPane.rowIndex="0">

        <!-- cabecera: logo + temporada -->
        <HBox fx:id="cajaMarca" alignment="BOTTOM_LEFT" spacing="14">
            <ImageView fx:id="logoF1" preserveRatio="true"/>
            <HBox fx:id="cajaTemporada" alignment="BOTTOM_LEFT">
                <padding><Insets bottom="3"/></padding>
            </HBox>
        </HBox>

        <!-- lista de opciones: la rellena el controlador -->
        <VBox fx:id="listaOpciones" fillWidth="true"/>

        <!-- descripción de la opción resaltada -->
        <Label fx:id="lblDescripcion" wrapText="true" styleClass="menu-descripcion"/>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- pie: salir + pistas de teclado -->
        <VBox fx:id="cajaPie" spacing="10">
            <Button fx:id="btnSalir" text="SALIR" styleClass="menu-salir"
                    onAction="#onSalir"/>
            <Label fx:id="lblPistas" styleClass="menu-pistas"
                   text="↑ ↓ NAVEGAR    ENTER SELECCIONAR    ESC SALIR"/>
        </VBox>
    </VBox>

    <!-- ==================== columna derecha ==================== -->
    <StackPane fx:id="escenario" styleClass="menu-escenario"
               GridPane.columnIndex="1" GridPane.rowIndex="0">

        <!-- Arte de la opción activa. Va el primero: es el fondo, y todo lo
             demás (velos, HUD, título) se pinta encima. Lo rellena el
             controlador, que es quien sabe qué opción está seleccionada. -->
        <Group fx:id="capaArte" managed="false"/>

        <!-- Velos sobre la foto: funden su borde izquierdo con la mitad negra
             del panel y oscurecen la parte baja para que el título se lea. -->
        <Region fx:id="veloArte" styleClass="menu-arte-velo" mouseTransparent="true"/>

        <!-- tira de estado, arriba a la derecha -->
        <HBox fx:id="cajaHud" styleClass="menu-hud" alignment="CENTER_RIGHT"
              spacing="0" maxWidth="-Infinity" maxHeight="-Infinity"
              StackPane.alignment="TOP_RIGHT"/>

        <!-- título de la sección, abajo. maxHeight ceñido al contenido: si no,
             el VBox llena el StackPane y la alineación BOTTOM no hace nada. -->
        <VBox fx:id="cajaTitulo" spacing="0" alignment="BOTTOM_LEFT"
              maxWidth="-Infinity" maxHeight="-Infinity"
              StackPane.alignment="BOTTOM_LEFT">
            <Region fx:id="fileteTitulo" styleClass="menu-escenario-filete"/>
            <Label fx:id="lblTituloSeccion" styleClass="menu-escenario-titulo"/>
            <Label fx:id="lblPieSeccion" styleClass="menu-escenario-pie"/>
        </VBox>
    </StackPane>
</GridPane>
