<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.CircuitController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <Label text="Circuitos" styleClass="view-title"/>
    <Label text="Doble clic sobre un circuito para ver su ficha completa." styleClass="view-subtitle"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="buscador" promptText="Buscar por nombre o ubicación…" prefWidth="320"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ver detalle" onAction="#onVerDetalle"/>
        <Button text="Nuevo" styleClass="primary" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" styleClass="danger" onAction="#onEliminar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Circuito" prefWidth="250"/>
            <TableColumn fx:id="colPais" text="País" prefWidth="180"/>
            <TableColumn fx:id="colLongitud" text="Long. (km)" prefWidth="90"/>
            <TableColumn fx:id="colVueltas" text="Vueltas" prefWidth="70"/>
            <TableColumn fx:id="colRecord" text="Récord" prefWidth="100"/>
            <TableColumn fx:id="colFactor" text="F. técnico" prefWidth="85"/>
        </columns>
    </TableView>
</VBox>
