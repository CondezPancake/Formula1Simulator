<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.HistoryController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="section-header">
        <Label text="HISTORIAL DE SESIONES" styleClass="view-title"/>
        <Label fx:id="lblConteoSesiones" styleClass="hint"/>
    </HBox>

    <!-- Balance del piloto elegido en cada sesión, calculado sobre la parrilla
         guardada: no hay ningún campo de resumen en el modelo. -->
    <HBox spacing="14">
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="VICTORIAS" styleClass="tile-label"/>
            <Label fx:id="lblVictorias" text="—" styleClass="tile-value,v-wear"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="PODIOS" styleClass="tile-label"/>
            <Label fx:id="lblPodios" text="—" styleClass="tile-value,v-accel"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="POSICIÓN MEDIA" styleClass="tile-label"/>
            <Label fx:id="lblPosicionMedia" text="—" styleClass="tile-value,v-fuel"/>
        </VBox>
        <VBox styleClass="metric-tile" HBox.hgrow="ALWAYS" spacing="3">
            <Label text="MEJOR VUELTA" styleClass="tile-label"/>
            <Label fx:id="lblMejorVuelta" text="—" styleClass="tile-value,v-time"/>
            <Label fx:id="lblMejorVueltaCircuito" styleClass="explore-card-foot"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="ORDENAR:" styleClass="tile-label"/>
        <Button fx:id="chipFecha" text="FECHA" styleClass="filter-chip,chip-selected" onAction="#onOrdenarFecha"/>
        <Button fx:id="chipPosicion" text="POSICIÓN" styleClass="filter-chip" onAction="#onOrdenarPosicion"/>
        <Button fx:id="chipTiempo" text="MEJOR TIEMPO" styleClass="filter-chip" onAction="#onOrdenarTiempo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Reutilizar configuración" onAction="#onReutilizar"/>
        <Button text="Actualizar" onAction="#onRefrescar"/>
        <Label text="Comparar en" styleClass="tile-label"/>
        <ComboBox fx:id="selectorCircuito" prefWidth="210"/>
    </HBox>

    <Label fx:id="lblVacio" styleClass="hint"
           text="Todavía no hay sesiones guardadas. Disputa una clasificación para verla aquí."/>

    <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
        <VBox spacing="6">
            <padding><Insets top="10" right="10" bottom="4" left="2"/></padding>
            <Label text="SESIONES" styleClass="card-label"/>
            <TableView fx:id="tablaSesiones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140"/>
                    <TableColumn fx:id="colCircuito" text="Circuito" prefWidth="190"/>
                    <TableColumn fx:id="colClima" text="Clima" prefWidth="85"/>
                    <TableColumn fx:id="colPole" text="Pole" prefWidth="150"/>
                    <TableColumn fx:id="colTiempoPole" text="Tiempo" prefWidth="95"/>
                    <TableColumn fx:id="colConfig" text="Configuración" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="6">
            <padding><Insets top="10" right="2" bottom="4" left="10"/></padding>
            <Label text="PARRILLA DE LA SESIÓN" styleClass="card-label"/>
            <TableView fx:id="tablaResultados" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPosicion" text="Pos" prefWidth="50"/>
                    <TableColumn fx:id="colPiloto" text="Piloto" prefWidth="160"/>
                    <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="170"/>
                    <TableColumn fx:id="colTiempo" text="Tiempo" prefWidth="100"/>
                    <TableColumn fx:id="colGap" text="Dif." prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>

    <LineChart fx:id="grafico" prefHeight="220" legendVisible="true">
        <xAxis><CategoryAxis label="Sesión"/></xAxis>
        <yAxis><NumberAxis label="Segundos" forceZeroInRange="false"/></yAxis>
    </LineChart>
</VBox>
