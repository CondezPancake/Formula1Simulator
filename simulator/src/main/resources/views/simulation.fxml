<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.SimulationController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <!-- La puesta a punto del monoplaza vive en CONFIG. & HISTORIAL, como en
         el diseño; aquí solo se elige quién sale a pista. -->
    <FlowPane hgap="14" vgap="10">
        <VBox spacing="4">
            <Label text="CIRCUITO" styleClass="card-label"/>
            <ComboBox fx:id="selectorCircuito" prefWidth="230"/>
        </VBox>
        <VBox spacing="4">
            <Label text="VEHÍCULO" styleClass="card-label"/>
            <ComboBox fx:id="selectorVehiculo" prefWidth="130"/>
        </VBox>
        <VBox spacing="4">
            <Label text="PILOTO" styleClass="card-label"/>
            <ComboBox fx:id="selectorPiloto" promptText="Selecciona un piloto" prefWidth="190" disable="true"/>
        </VBox>
        <VBox spacing="4">
            <Label text="PUESTA A PUNTO" styleClass="card-label"/>
            <Label fx:id="lblPuestaAPunto" text="—" styleClass="stat-value"/>
        </VBox>
    </FlowPane>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnSimular" text="Iniciar clasificación" styleClass="primary" onAction="#onSimular"/>
        <ProgressBar fx:id="progreso" progress="0" prefWidth="240"/>
        <Label fx:id="lblEstado" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblClima" text="" styleClass="section-title"/>
    </HBox>

    <Separator/>

    <VBox spacing="8" styleClass="evolution-panel">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Evolución del vehículo seleccionado" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Los valores provienen del cálculo de la vuelta" styleClass="hint"/>
        </HBox>

        <!-- Fila 1: lo que le pasa al coche en la vuelta en curso. -->
        <HBox spacing="12">
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Vuelta del piloto" styleClass="card-label"/>
                <Label fx:id="lblPilotoEvolucion" text="Esperando inicio de vuelta" styleClass="metric-value"/>
                <ProgressBar fx:id="progresoVuelta" progress="0" maxWidth="Infinity"/>
                <Label fx:id="lblSegmentoEvolucion" text="Segmento —/20" styleClass="hint"/>
                <Label fx:id="lblTiempoEvolucion" text="—" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Velocidad actual" styleClass="card-label"/>
                <Label fx:id="lblVelocidad" text="0 km/h" styleClass="metric-value"/>
                <Label fx:id="lblVelocidadMaxima" text="Máxima alcanzada: 0 km/h" styleClass="hint"/>
                <ProgressBar fx:id="barraVelocidad" progress="0" maxWidth="Infinity" styleClass="metric-speed"/>
                <Label fx:id="lblRpmEvolucion" text="— rpm" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Consumo acumulado" styleClass="card-label"/>
                <Label fx:id="lblConsumoEvolucion" text="0.00 / 0.00 u" styleClass="metric-value"/>
                <ProgressBar fx:id="barraConsumo" progress="0" maxWidth="Infinity" styleClass="metric-consumption"/>
                <Label fx:id="lblCombustibleRestante" text="Restante —" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Desgaste acumulado" styleClass="card-label"/>
                <Label fx:id="lblDesgasteEvolucion" text="0.00 / 0.00 u" styleClass="metric-value"/>
                <ProgressBar fx:id="barraDesgaste" progress="0" maxWidth="Infinity" styleClass="metric-wear"/>
                <Label fx:id="lblTemperaturasEvolucion" text="—" styleClass="hint"/>
            </VBox>
        </HBox>

        <!-- Fila 2: el estado de la pista y del cielo, que antes vivian en dos
             pestanas propias. Aqui se ven sin abrir nada, que es cuando
             importan: el piloto seleccionado rueda primero. -->
        <HBox spacing="12">
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Grip de pista" styleClass="card-label"/>
                <Label fx:id="lblGripPista" text="—" styleClass="metric-value"/>
                <ProgressBar fx:id="barraGripPista" progress="0" maxWidth="Infinity" styleClass="metric-grip"/>
                <Label fx:id="lblCambioGrip" text="Sin datos de pista" styleClass="hint"/>
                <Label fx:id="lblGomaPista" text="—" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Cielo y asfalto" styleClass="card-label"/>
                <Label fx:id="lblTempClimaEvolucion" text="—" styleClass="metric-value"/>
                <Label fx:id="lblEstadoClimaEvolucion" text="Sin datos de sesión" styleClass="hint"/>
                <Label fx:id="lblLluviaEvolucion" text="—" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Neumático recomendado" styleClass="card-label"/>
                <Label fx:id="lblNeumaticoEvolucion" text="—" styleClass="metric-value"/>
                <Label fx:id="lblEstrategiaEvolucion" text="—" styleClass="hint"/>
            </VBox>
            <VBox spacing="6" styleClass="evolution-card" HBox.hgrow="ALWAYS">
                <Label text="Sector en curso" styleClass="card-label"/>
                <Label fx:id="lblSectorEvolucion" text="—" styleClass="metric-value"/>
                <Label fx:id="lblEstadoVueltaEvolucion" text="—" styleClass="hint"/>
            </VBox>
        </HBox>
    </VBox>

    <TabPane fx:id="panelResultados" styleClass="subnav" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Clasificación">
                <TableView fx:id="tabla">
                    <columns>
                        <TableColumn fx:id="colPosicion" text="Pos" prefWidth="45"/>
                        <TableColumn fx:id="colPiloto" text="Piloto" prefWidth="145"/>
                        <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="145"/>
                        <TableColumn fx:id="colVehiculo" text="Vehículo" prefWidth="75"/>
                        <TableColumn fx:id="colTiempo" text="Tiempo" prefWidth="90"/>
                        <TableColumn fx:id="colGap" text="Dif." prefWidth="65"/>
                        <TableColumn fx:id="colConsumo" text="Consumo" prefWidth="75"/>
                        <TableColumn fx:id="colDesgaste" text="Desgaste" prefWidth="75"/>
                        <TableColumn fx:id="colEstadoVuelta" text="Estado" prefWidth="90"/>
                        <TableColumn fx:id="colEventoResultado" text="Evento" prefWidth="145"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab fx:id="tabTelemetria" text="Telemetría en vivo">
                <VBox spacing="12" styleClass="telemetry-panel">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="LIVE TELEMETRY" styleClass="telemetry-title"/>
                            <Label fx:id="lblTelemetriaPiloto"
                                   text="Esperando datos del vehículo seleccionado" styleClass="hint"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="2" alignment="CENTER_RIGHT">
                            <Label fx:id="lblEventoTelemetria" text="Sin evento" styleClass="event-live"/>
                            <Label fx:id="lblEstadoPiloto" text="Vuelta válida" styleClass="hint"/>
                        </VBox>
                        <Label fx:id="lblEstadoPista" text="Estado de pista —" styleClass="track-state"/>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="VELOCIDAD ACTUAL" styleClass="card-label"/>
                            <Label fx:id="lblVelocidadTelemetria" text="0 km/h" styleClass="telemetry-value"/>
                            <Label fx:id="lblVelocidadMaximaTelemetria"
                                   text="Máxima alcanzada: 0 km/h" styleClass="hint"/>
                            <ProgressBar fx:id="barraVelocidadTelemetria" progress="0" maxWidth="Infinity"
                                         styleClass="metric-speed"/>
                        </VBox>
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="RPM" styleClass="card-label"/>
                            <Label fx:id="lblRpm" text="0 rpm" styleClass="telemetry-value"/>
                            <ProgressBar fx:id="barraRpm" progress="0" maxWidth="Infinity"
                                         styleClass="metric-rpm"/>
                        </VBox>
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="CONSUMO DE COMBUSTIBLE" styleClass="card-label"/>
                            <Label fx:id="lblCombustible" text="0.00 kg/v · 0 % consumido" styleClass="telemetry-value"/>
                            <ProgressBar fx:id="barraCombustible" progress="0" maxWidth="Infinity"
                                         styleClass="metric-fuel"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="DESGASTE DE NEUMÁTICOS" styleClass="card-label"/>
                            <Label fx:id="lblDesgasteTelemetria" text="0.0 %" styleClass="telemetry-value"/>
                            <ProgressBar fx:id="barraDesgasteTelemetria" progress="0" maxWidth="Infinity"
                                         styleClass="metric-wear"/>
                        </VBox>
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="TEMP. NEUMÁTICOS" styleClass="card-label"/>
                            <Label fx:id="lblTempNeumaticos" text="0.0 °C" styleClass="telemetry-value"/>
                            <ProgressBar fx:id="barraTempNeumaticos" progress="0" maxWidth="Infinity"
                                         styleClass="metric-temperature"/>
                        </VBox>
                        <VBox spacing="6" styleClass="telemetry-card" HBox.hgrow="ALWAYS">
                            <Label text="TEMP. MOTOR" styleClass="card-label"/>
                            <Label fx:id="lblTempMotor" text="0.0 °C" styleClass="telemetry-value"/>
                            <ProgressBar fx:id="barraTempMotor" progress="0" maxWidth="Infinity"
                                         styleClass="metric-engine"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox spacing="4" styleClass="telemetry-summary" HBox.hgrow="ALWAYS">
                            <Label text="SECTOR ACTUAL" styleClass="card-label"/>
                            <Label fx:id="lblSector" text="S—" styleClass="telemetry-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="telemetry-summary" HBox.hgrow="ALWAYS">
                            <Label text="TIEMPO DE VUELTA" styleClass="card-label"/>
                            <Label fx:id="lblTiempoVuelta" text="0:00.000" styleClass="telemetry-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="telemetry-summary" HBox.hgrow="ALWAYS">
                            <Label text="DELTA VS. RÉCORD" styleClass="card-label"/>
                            <Label fx:id="lblDelta" text="±0.000" styleClass="telemetry-value"/>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Comparación de sectores">
                <fx:include fx:id="comparacionSectores" source="sector-comparison.fxml"/>
            </Tab>
            <Tab text="Eventos">
                <VBox spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Registro de eventos de la sesión" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="NO_EVENT no se almacena para mantener el registro limpio" styleClass="hint"/>
                    </HBox>
                    <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="La sesión terminó sin eventos"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colEventoPiloto" text="Piloto" prefWidth="160"/>
                            <TableColumn fx:id="colEventoNombre" text="Evento" prefWidth="180"/>
                            <TableColumn fx:id="colEventoCategoria" text="Categoría" prefWidth="135"/>
                            <TableColumn fx:id="colEventoAlcance" text="Alcance" prefWidth="95"/>
                            <TableColumn fx:id="colEventoSector" text="Sector" prefWidth="90"/>
                            <TableColumn fx:id="colEventoImpacto" text="Impacto" prefWidth="120"/>
                            <TableColumn fx:id="colEventoBandera" text="Pista" prefWidth="145"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
