<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.SimulationController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <Label text="Sesión de clasificación" styleClass="view-title"/>
    <Label text="Configura el monoplaza y disputa la sesión: el clima se genera al azar según el circuito."
           styleClass="view-subtitle"/>

    <FlowPane hgap="14" vgap="10">
        <VBox spacing="4">
            <Label text="Circuito" styleClass="card-label"/>
            <ComboBox fx:id="selectorCircuito" prefWidth="230"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Vehículo" styleClass="card-label"/>
            <ComboBox fx:id="selectorVehiculo" prefWidth="130"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Conducción" styleClass="card-label"/>
            <ComboBox fx:id="selectorModo" prefWidth="180"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Aerodinámica" styleClass="card-label"/>
            <ComboBox fx:id="selectorAero" prefWidth="120"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Presión" styleClass="card-label"/>
            <ComboBox fx:id="selectorPresion" prefWidth="120"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Combustible" styleClass="card-label"/>
            <ComboBox fx:id="selectorCombustible" prefWidth="140"/>
        </VBox>
    </FlowPane>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnSimular" text="Iniciar clasificación" styleClass="primary" onAction="#onSimular"/>
        <ProgressBar fx:id="progreso" progress="0" prefWidth="240"/>
        <Label fx:id="lblEstado" text=""/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblClima" text="" styleClass="section-title"/>
    </HBox>

    <Separator/>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPosicion" text="Pos" prefWidth="50"/>
            <TableColumn fx:id="colPiloto" text="Piloto" prefWidth="170"/>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="180"/>
            <TableColumn fx:id="colVehiculo" text="Vehículo" prefWidth="90"/>
            <TableColumn fx:id="colTiempo" text="Tiempo" prefWidth="100"/>
            <TableColumn fx:id="colGap" text="Dif." prefWidth="80"/>
            <TableColumn fx:id="colConsumo" text="Consumo" prefWidth="85"/>
            <TableColumn fx:id="colDesgaste" text="Desgaste" prefWidth="85"/>
        </columns>
    </TableView>
</VBox>
