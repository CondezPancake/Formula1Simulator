<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.SimulationController"
      spacing="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Simulación de Clasificación" styleClass="view-title"/>
    <Button fx:id="btnStartQualifying" text="Iniciar Clasificación" onAction="#onStartQualifying"/>
    <TableView fx:id="tableResults" VBox.vgrow="ALWAYS"/>
</VBox>
