<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.adapter.in.javafx.DriverController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <Label text="Gestión" styleClass="view-title"/>
    <Label text="Registra, edita y busca los competidores de la parrilla." styleClass="view-subtitle"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="buscador" promptText="Buscar por nombre, equipo o rol…" prefWidth="320"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Agregar nuevo" styleClass="primary" onAction="#onNuevo"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="section-header">
        <Label text="PILOTOS" styleClass="section-title"/>
        <Label fx:id="lblConteo" styleClass="count-badge"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="#" prefWidth="40"/>
            <TableColumn fx:id="colNombre" text="Piloto" prefWidth="170"/>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="180"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="85"/>
            <TableColumn fx:id="colExperiencia" text="Exp." prefWidth="55"/>
            <TableColumn fx:id="colVelocidad" text="Velocidad /100" prefWidth="105"/>
            <TableColumn fx:id="colConsistencia" text="Consistencia /100" prefWidth="115"/>
            <TableColumn fx:id="colLluvia" text="Lluvia /100" prefWidth="90"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
