<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Gestión de pilotos: tabla filtrable a la izquierda y ficha de detalle a la
  derecha. El alta/edición/baja siguen siendo los diálogos de Forms.piloto(...)
  y DriverService; esto solo cambia cómo se navega hasta ellos.
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.adapter.in.javafx.DriverController"
      styleClass="mgmt-root" spacing="14">
    <padding><Insets top="24" right="26" bottom="20" left="26"/></padding>

    <!-- ============================ CABECERA ============================ -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="PILOTOS" styleClass="mgmt-title"/>
            <Label text="Gestiona tu parrilla de pilotos" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="0">
            <Label fx:id="lblConteo" text="0 / 0" styleClass="mgmt-count-value"/>
            <Label text="PILOTOS REGISTRADOS" styleClass="mgmt-count-label"/>
        </VBox>
    </HBox>

    <!-- ============================ TOOLBAR ============================= -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="mgmt-toolbar">
        <TextField fx:id="buscador" promptText="Buscar piloto…" prefWidth="240"/>
        <ComboBox fx:id="filtroEquipo" promptText="TODOS LOS EQUIPOS" prefWidth="168"/>
        <ComboBox fx:id="filtroRol" promptText="TODOS LOS ROLES" prefWidth="150"/>
        <ComboBox fx:id="filtroNacionalidad" promptText="NACIONALIDAD" prefWidth="150"/>
        <ComboBox fx:id="ordenarPor" prefWidth="140"/>
        <Button fx:id="btnOrdenDireccion" styleClass="icon-button" text="↓"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="+ NUEVO PILOTO" styleClass="primary,mgmt-new-button"/>
    </HBox>

    <!-- ============================ CONTENIDO ============================ -->
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.7" styleClass="mgmt-split">

        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colId" text="#" prefWidth="40"/>
                <TableColumn fx:id="colNombre" text="Piloto" prefWidth="170"/>
                <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="180"/>
                <TableColumn fx:id="colRol" text="Rol" prefWidth="90"/>
                <TableColumn fx:id="colOvr" text="OVR" prefWidth="60"/>
                <TableColumn fx:id="colVelocidad" text="Velocidad" prefWidth="85"/>
                <TableColumn fx:id="colConsistencia" text="Consistencia" prefWidth="95"/>
                <TableColumn fx:id="colLluvia" text="Lluvia" prefWidth="75"/>
                <TableColumn fx:id="colExperiencia" text="Exp." prefWidth="60"/>
            </columns>
        </TableView>

        <!-- ============================ Ficha lateral ============================ -->
        <StackPane fx:id="panelDetalle" styleClass="mgmt-detail"
                   minWidth="360" prefWidth="360" maxWidth="360">
            <VBox fx:id="detalleVacio" alignment="CENTER" spacing="8">
                <Label text="Selecciona un piloto" styleClass="mgmt-empty-title"/>
                <Label text="Elige una fila de la tabla para ver su ficha." styleClass="mgmt-empty-subtitle" wrapText="true"/>
            </VBox>

            <ScrollPane fx:id="detalleScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="edge-to-edge" visible="false" managed="false">
                <VBox fx:id="detalleContenido" visible="false" managed="false" spacing="0">
                    <StackPane fx:id="detalleFoto" styleClass="mgmt-detail-photo"/>

                    <VBox spacing="2" styleClass="mgmt-detail-identidad">
                        <padding><Insets top="14" right="18" bottom="6" left="18"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <VBox spacing="0" minWidth="0" HBox.hgrow="ALWAYS">
                                <Label fx:id="detalleNombrePila" styleClass="mgmt-detail-first"
                                       maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                                <Label fx:id="detalleApellido" styleClass="mgmt-detail-last"
                                       maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="0">
                                <Label text="OVR" styleClass="mgmt-ovr-label"/>
                                <Label fx:id="detalleOvr" styleClass="mgmt-detail-ovr"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="detalleEquipo" styleClass="mgmt-detail-team"
                               maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                        <Label fx:id="detalleRol" styleClass="mgmt-role-chip"/>
                    </VBox>

                    <TabPane fx:id="tabsDetalle" tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <Tab text="RESUMEN">
                                <VBox spacing="14">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                    <VBox spacing="4">
                                        <Label text="ATRIBUTOS" styleClass="mgmt-section-label"/>
                                        <VBox fx:id="tabResumenAtributos" spacing="10"/>
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label text="INFORMACIÓN" styleClass="mgmt-section-label"/>
                                        <VBox fx:id="tabResumenInfo" spacing="8"/>
                                    </VBox>
                                </VBox>
                            </Tab>
                            <Tab text="ESTADÍSTICAS">
                                <VBox fx:id="tabEstadisticas" spacing="10">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                </VBox>
                            </Tab>
                            <Tab text="HISTORIAL">
                                <VBox fx:id="tabHistorial" spacing="10">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>

                    <VBox spacing="8" styleClass="mgmt-detail-acciones">
                        <padding><Insets top="12" right="18" bottom="18" left="18"/></padding>
                        <Button fx:id="btnEditar" text="EDITAR PILOTO" maxWidth="Infinity"
                                styleClass="mgmt-action-button"/>
                        <Button fx:id="btnEliminar" text="ELIMINAR PILOTO" maxWidth="Infinity"
                                styleClass="mgmt-delete-button"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </SplitPane>
</VBox>
