<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.DriverController" spacing="12">
    <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

    <Label text="Pilotos" styleClass="view-title"/>
    <Label text="Registra, edita y busca los competidores de la parrilla." styleClass="view-subtitle"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="buscador" promptText="Buscar por nombre, equipo o rol…" prefWidth="320"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" styleClass="primary" onAction="#onNuevo"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Eliminar" styleClass="danger" onAction="#onEliminar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="#" prefWidth="45"/>
            <TableColumn fx:id="colNombre" text="Piloto" prefWidth="180"/>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="190"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="90"/>
            <TableColumn fx:id="colExperiencia" text="Exp." prefWidth="60"/>
            <TableColumn fx:id="colVelocidad" text="Velocidad" prefWidth="85"/>
            <TableColumn fx:id="colConsistencia" text="Consistencia" prefWidth="95"/>
            <TableColumn fx:id="colLluvia" text="Lluvia" prefWidth="70"/>
        </columns>
    </TableView>
</VBox>
