<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.formula1.adapter.in.javafx.ExploreController"
         styleClass="subnav" tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text="PILOTOS">
            <fx:include fx:id="pilotosView" source="explore-drivers.fxml"/>
        </Tab>
        <Tab text="TEAMS">
            <fx:include fx:id="equiposView" source="explore-teams.fxml"/>
        </Tab>
    </tabs>
</TabPane>
