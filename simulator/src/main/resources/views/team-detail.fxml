<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Ficha de escudería, con el reparto de formula1.com/en/teams/<equipo>:
  cabecera con el logo y el nombre sobre el color del equipo, el monoplaza a
  lo grande, sus datos y la pareja de pilotos.

  Mismo esqueleto que driver-detail para que las dos fichas se sientan de la
  misma familia.
-->
<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.formula1.controller.TeamDetailController"
            styleClass="circuit-detail" fitToWidth="true">

    <VBox spacing="18" styleClass="circuit-detail-body">
        <padding><Insets top="26" right="26" bottom="26" left="26"/></padding>

        <!-- cabecera -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <StackPane fx:id="marcoLogo" styleClass="team-detail-logo"/>
            <VBox spacing="2">
                <Label fx:id="lblNombre" styleClass="view-title"/>
                <Label fx:id="lblMeta" styleClass="hint"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="← VOLVER" styleClass="icon-button" onAction="#onVolver"/>
        </HBox>

        <!-- monoplaza + datos -->
        <HBox spacing="18">
            <StackPane fx:id="marcoCoche" styleClass="team-detail-car"/>
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="lblModelo" styleClass="detail-kicker"/>
                <Label fx:id="lblMotorCoche" styleClass="detail-help"/>
                <HBox fx:id="fichaCoche" spacing="10"/>
            </VBox>
        </HBox>

        <!-- pilotos -->
        <VBox spacing="12" styleClass="detail-panel">
            <Label text="PILOTOS" styleClass="detail-kicker"/>
            <Label text="Pulsa sobre un piloto para abrir su ficha." styleClass="detail-help"/>
            <FlowPane fx:id="tarjetasPilotos" hgap="14" vgap="14"/>
        </VBox>
    </VBox>
</ScrollPane>
