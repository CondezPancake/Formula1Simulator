<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.LapEvolutionController"
      spacing="10" styleClass="lap-evolution-panel">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="LAP PERFORMANCE" styleClass="telemetry-title"/>
            <Label text="Tres sectores de pista · una lectura consolidada al cierre de cada sector"
                   styleClass="hint"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Métrica" styleClass="card-label"/>
        <ComboBox fx:id="selectorMetrica" prefWidth="230"/>
    </HBox>

    <Label wrapText="true" styleClass="hint"
           text="S1 · Inicio: salida al primer corte  ·  S2 · Intermedio: primer al segundo corte  ·  S3 · Final: segundo corte a meta. Los valores son acumulados al cierre de cada sector."/>

    <HBox spacing="12">
        <VBox spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="PROGRESO" styleClass="card-label"/>
            <Label fx:id="lblProgreso" text="Esperando vuelta" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="TENDENCIA" styleClass="card-label"/>
            <Label fx:id="lblTendencia" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="RANGO DE LA MÉTRICA" styleClass="card-label"/>
            <Label fx:id="lblRango" text="—" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <LineChart fx:id="grafico" legendVisible="false" prefHeight="245" VBox.vgrow="ALWAYS">
        <xAxis>
            <NumberAxis label="Sector (S1 · S2 · S3)" lowerBound="1" upperBound="3"
                        tickUnit="1" autoRanging="false" forceZeroInRange="false"/>
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="ejeValor" forceZeroInRange="false"/>
        </yAxis>
    </LineChart>

    <TableView fx:id="tabla" prefHeight="205" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="La evolución aparecerá al iniciar una clasificación"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colSector" text="Sector de pista" prefWidth="125"/>
            <TableColumn fx:id="colVelocidad" text="Velocidad" prefWidth="95"/>
            <TableColumn fx:id="colTiempo" text="Tiempo acum." prefWidth="100"/>
            <TableColumn fx:id="colDelta" text="Delta acum." prefWidth="95"/>
            <TableColumn fx:id="colCombustible" text="Combustible" prefWidth="100"/>
            <TableColumn fx:id="colDesgaste" text="Desgaste" prefWidth="90"/>
            <TableColumn fx:id="colTemperaturas" text="Temperaturas" prefWidth="190"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
