<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.formula1.controller.ShellController"
            prefWidth="1600" prefHeight="940">

    <top>
        <VBox>
            <!-- ============ barra superior persistente (54 px) ============ -->
            <HBox fx:id="cabecera" styleClass="app-header" spacing="0" alignment="CENTER_LEFT">
                <padding><Insets left="20" right="20"/></padding>

                <Label text="F1" styleClass="brand-mark"/>

                <Region styleClass="header-divider">
                    <HBox.margin><Insets left="18" right="18"/></HBox.margin>
                </Region>

                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label fx:id="lblEvento" text="SIMULADOR DE CLASIFICACIÓN" styleClass="header-title"/>
                    <Label fx:id="lblCircuitoCabecera" text="SIN CIRCUITO SELECCIONADO" styleClass="header-subtitle"/>
                </VBox>

                <Label fx:id="lblEstadoSesion" text="● LISTO" styleClass="live-badge,off">
                    <HBox.margin><Insets left="22"/></HBox.margin>
                </Label>

                <VBox spacing="0" alignment="CENTER_LEFT">
                    <HBox.margin><Insets left="18"/></HBox.margin>
                    <Label text="SEGMENTO" styleClass="micro-label"/>
                    <HBox spacing="2" alignment="BOTTOM_LEFT">
                        <Label fx:id="lblSegmentoActual" text="—" styleClass="counter-value"/>
                        <Label fx:id="lblSegmentoTotal" text="/20" styleClass="counter-total"/>
                    </HBox>
                </VBox>

                <Region styleClass="header-divider">
                    <HBox.margin><Insets left="18" right="18"/></HBox.margin>
                </Region>

                <Label fx:id="lblIconoClima" text="☁" style="-fx-font-size: 20px;"/>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <HBox.margin><Insets left="10"/></HBox.margin>
                    <Label fx:id="lblClimaTemp" text="— · ASFALTO —" styleClass="header-value"/>
                    <Label fx:id="lblClimaEstado" text="SIN DATOS DE SESIÓN" styleClass="header-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="6" alignment="CENTER">
                    <Label fx:id="banderaVerde"    text="VERDE"    styleClass="flag-pill"/>
                    <Label fx:id="banderaAmarilla" text="AMARILLA" styleClass="flag-pill"/>
                    <Label fx:id="banderaRoja"     text="ROJA"     styleClass="flag-pill"/>
                </HBox>

                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <HBox.margin><Insets left="22"/></HBox.margin>
                    <Label fx:id="lblZonaHoraria" text="UTC" styleClass="micro-label"/>
                    <Label fx:id="lblReloj" text="--:--:--" styleClass="header-clock"/>
                </VBox>
            </HBox>

            <!-- ============ nav de secciones (44 px) ============ -->
            <HBox fx:id="navegacion" styleClass="top-nav" spacing="0" alignment="CENTER_LEFT">
                <padding><Insets left="20"/></padding>
                <Button fx:id="btnCarrera"  text="CARRERA"             styleClass="top-nav-item" onAction="#onCarrera"/>
                <Button fx:id="btnExplorar" text="EXPLORAR"            styleClass="top-nav-item" onAction="#onExplorar"/>
                <Button fx:id="btnGestion"  text="GESTIÓN"             styleClass="top-nav-item" onAction="#onGestion"/>
                <Button fx:id="btnConfig"   text="CONFIG. &amp; HISTORIAL" styleClass="top-nav-item" onAction="#onConfigHistorial"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="SALIR" styleClass="top-nav-item,exit-nav-item" onAction="#onSalir">
                    <HBox.margin><Insets right="20"/></HBox.margin>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contenido" styleClass="contenido"/>
    </center>

    <bottom>
        <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="7" right="20" bottom="7" left="20"/></padding>
            <ProgressIndicator fx:id="cargando" prefWidth="14" prefHeight="14" visible="false"/>
            <Label fx:id="lblEstado" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
