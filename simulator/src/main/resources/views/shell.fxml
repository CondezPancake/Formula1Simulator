<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.formula1.controller.ShellController"
            prefWidth="1180" prefHeight="760">

    <left>
        <VBox fx:id="navegacion" styleClass="nav" spacing="4" prefWidth="210">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>

            <Label text="FORMULA 1" styleClass="nav-brand"/>
            <Label text="SIMULATOR" styleClass="nav-brand-accent"/>

            <Separator>
                <VBox.margin><Insets top="14" bottom="10"/></VBox.margin>
            </Separator>

            <Button text="Inicio"       styleClass="nav-button" maxWidth="Infinity" onAction="#onInicio"/>
            <Button text="Pilotos"      styleClass="nav-button" maxWidth="Infinity" onAction="#onPilotos"/>
            <Button text="Equipos"      styleClass="nav-button" maxWidth="Infinity" onAction="#onEquipos"/>
            <Button text="Vehículos"    styleClass="nav-button" maxWidth="Infinity" onAction="#onVehiculos"/>
            <Button text="Circuitos"    styleClass="nav-button" maxWidth="Infinity" onAction="#onCircuitos"/>

            <Separator>
                <VBox.margin><Insets top="10" bottom="10"/></VBox.margin>
            </Separator>

            <Button text="Clasificación" styleClass="nav-button,nav-primary" maxWidth="Infinity" onAction="#onSimulacion"/>
            <Button text="Historial"     styleClass="nav-button" maxWidth="Infinity" onAction="#onHistorial"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenido" styleClass="contenido"/>
    </center>

    <bottom>
        <HBox styleClass="status-bar" spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <ProgressIndicator fx:id="cargando" prefWidth="16" prefHeight="16" visible="false"/>
            <Label fx:id="lblEstado" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
