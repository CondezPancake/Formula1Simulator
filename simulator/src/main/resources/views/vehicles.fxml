<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Gestión de vehículos: tabla filtrable a la izquierda y ficha de detalle a
  la derecha, mismo patrón que Pilotos y Equipos. Comparar y Asignar pilotos
  operan sobre la selección de la tabla, así que se quedan en la barra de
  herramientas; Editar/Eliminar (un solo vehículo) viven en la ficha.
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.VehicleController"
      styleClass="mgmt-root" spacing="14">
    <padding><Insets top="24" right="26" bottom="20" left="26"/></padding>

    <!-- ============================ CABECERA ============================ -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="VEHÍCULOS" styleClass="mgmt-title"/>
            <Label text="Ctrl + clic para seleccionar varios y compararlos" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="0">
            <Label fx:id="lblConteo" text="0 / 0" styleClass="mgmt-count-value"/>
            <Label text="VEHÍCULOS REGISTRADOS" styleClass="mgmt-count-label"/>
        </VBox>
    </HBox>

    <!-- ============================ TOOLBAR ============================= -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="mgmt-toolbar">
        <TextField fx:id="buscador" promptText="Buscar vehículo…" prefWidth="200"/>
        <ComboBox fx:id="filtroEquipo" promptText="TODOS LOS EQUIPOS" prefWidth="160"/>
        <Label text="Vel. mín."/>
        <Spinner fx:id="velocidadMinima" prefWidth="90"/>
        <ComboBox fx:id="ordenarPor" prefWidth="140"/>
        <Button fx:id="btnOrdenDireccion" styleClass="icon-button" text="↓"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnComparar" text="Comparar" styleClass="icon-button"/>
        <Button fx:id="btnAsignarPilotos" text="Asignar pilotos" styleClass="icon-button"/>
        <Button fx:id="btnNuevo" text="+ NUEVO VEHÍCULO" styleClass="primary,mgmt-new-button"/>
    </HBox>

    <!-- ============================ CONTENIDO ============================ -->
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.7" styleClass="mgmt-split">

        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="100"/>
                <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="170"/>
                <TableColumn fx:id="colMotor" text="Motor" prefWidth="100"/>
                <TableColumn fx:id="colVelMax" text="Vel. máx." prefWidth="80"/>
                <TableColumn fx:id="colAceleracion" text="0-100" prefWidth="65"/>
                <TableColumn fx:id="colVelNormal" text="Media (normal)" prefWidth="110"/>
            </columns>
        </TableView>

        <!-- ============================ Ficha lateral ============================ -->
        <StackPane fx:id="panelDetalle" styleClass="mgmt-detail"
                   minWidth="360" prefWidth="360" maxWidth="360">
            <VBox fx:id="detalleVacio" alignment="CENTER" spacing="8">
                <Label text="Selecciona un vehículo" styleClass="mgmt-empty-title"/>
                <Label text="Elige una fila de la tabla para ver su ficha." styleClass="mgmt-empty-subtitle" wrapText="true"/>
            </VBox>

            <ScrollPane fx:id="detalleScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="edge-to-edge" visible="false" managed="false">
                <VBox fx:id="detalleContenido" visible="false" managed="false" spacing="0">
                    <StackPane fx:id="detalleFoto" styleClass="mgmt-detail-photo"/>

                    <VBox spacing="2">
                        <padding><Insets top="14" right="18" bottom="6" left="18"/></padding>
                        <Label fx:id="detalleModelo" styleClass="mgmt-detail-last"
                               maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                        <Label fx:id="detalleSubtitulo" styleClass="mgmt-detail-team"
                               maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                    </VBox>

                    <TabPane fx:id="tabsDetalle" tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <Tab text="RESUMEN">
                                <VBox spacing="14">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                    <VBox spacing="4">
                                        <Label text="RENDIMIENTO" styleClass="mgmt-section-label"/>
                                        <VBox fx:id="tabResumenAtributos" spacing="10"/>
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label text="INFORMACIÓN" styleClass="mgmt-section-label"/>
                                        <VBox fx:id="tabResumenInfo" spacing="8"/>
                                    </VBox>
                                </VBox>
                            </Tab>
                            <Tab text="ESTADÍSTICAS">
                                <VBox fx:id="tabEstadisticas" spacing="10">
                                    <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>

                    <VBox spacing="8">
                        <padding><Insets top="12" right="18" bottom="18" left="18"/></padding>
                        <Button fx:id="btnEditar" text="EDITAR VEHÍCULO" maxWidth="Infinity"
                                styleClass="mgmt-action-button"/>
                        <Button fx:id="btnEliminar" text="ELIMINAR VEHÍCULO" maxWidth="Infinity"
                                styleClass="mgmt-delete-button"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </SplitPane>
</VBox>
