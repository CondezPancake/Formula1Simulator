<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.formula1.controller.SessionAnalysisController"
      spacing="12" styleClass="session-analysis-panel">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="ANALISIS AUTOMATICO" styleClass="analysis-title"/>
            <Label fx:id="lblResumen" text="Esperando resultados" styleClass="hint"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="2" alignment="CENTER_RIGHT">
            <Label text="Pole" styleClass="card-label"/>
            <Label fx:id="lblPole" text="--" styleClass="analysis-pole"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="4" styleClass="analysis-card" HBox.hgrow="ALWAYS">
            <Label text="Tiempo" styleClass="card-label"/>
            <Label fx:id="lblTiempo" text="--" styleClass="analysis-value"/>
        </VBox>
        <VBox spacing="4" styleClass="analysis-card" HBox.hgrow="ALWAYS">
            <Label text="Vueltas validas" styleClass="card-label"/>
            <Label fx:id="lblParticipantes" text="0" styleClass="analysis-value"/>
        </VBox>
    </HBox>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Factores positivos" styleClass="section-title"/>
            <ListView fx:id="listaPositivos" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Factores negativos" styleClass="section-title"/>
            <ListView fx:id="listaNegativos" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Claves" styleClass="section-title"/>
            <ListView fx:id="listaClaves" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
